{
    "i18n": true,
    "type": "tabs",
    "iconPosition": "start",
    "items": {
        "tabHome": {
            "type": "panel",
            "label": "Home",
            "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSIjMTU2NUMwIj48cGF0aCBkPSJNMTAgMjB2LTZoNHY2aDV2LThoM0wxMiAzIDIgMTJoM3Y4eiIvPjwvc3ZnPg==",
            "items": {
                "_logo": {
                    "type": "staticImage",
                    "src": "hydrawise.jpg",
                    "xs": 12,
                    "sm": 2,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "_title": {
                    "type": "header",
                    "text": "Use GraphQL; REST is a fallback",
                    "size": 3,
                    "xs": 12,
                    "sm": 10,
                    "md": 10,
                    "lg": 10,
                    "xl": 10
                },
                "_intro": {
                    "type": "staticText",
                    "text": "Both APIs provide zones and schedules. v2 (GraphQL) is recommended: same login as the Hydrawise app, plus weather and sensors. v1 (REST) is a fallback via API key if GraphQL is unavailable. At least one API must be on.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_div1": {
                    "type": "divider",
                    "newLine": true,
                    "color": "primary",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_openApp": {
                    "type": "staticLink",
                    "label": "open hydrawise app",
                    "href": "https://app.hydrawise.com/config/dashboard",
                    "button": true,
                    "variant": "contained",
                    "color": "primary",
                    "icon": "web",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "_openAccount": {
                    "type": "staticLink",
                    "label": "open account details",
                    "href": "https://app.hydrawise.com/config/account-details",
                    "button": true,
                    "variant": "outlined",
                    "color": "primary",
                    "icon": "auth",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "tabV1": {
            "type": "panel",
            "label": "v1 API",
            "icon": "data:image/svg+xml;base64,",
            "items": {
                "_v1Header": {
                    "type": "header",
                    "text": "REST API (fallback)",
                    "size": 4,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_v1Intro": {
                    "type": "staticText",
                    "text": "Only needed if GraphQL is unavailable. Same zones and schedules as v2, without weather and sensors. customerdetails is limited to 5 requests / 5 minutes.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "enableV1": {
                    "type": "checkbox",
                    "label": "Enable v1 API (REST)",
                    "newLine": true,
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "apiKey": {
                    "type": "password",
                    "label": "api key",
                    "newLine": true,
                    "hidden": "!enableV1",
                    "help": "how to get token",
                    "helpLink": "https://github.com/SentiQ/ioBroker.hydrawise/blob/main/README.md#documentation",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "apiInterval": {
                    "type": "number",
                    "label": "api interval",
                    "newLine": true,
                    "default": 60,
                    "min": 15,
                    "unit": "s",
                    "hidden": "!enableV1",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "tabV2": {
            "type": "panel",
            "label": "v2 API",
            "icon": "data:image/svg+xml;base64,",
            "items": {
                "_v2Header": {
                    "type": "header",
                    "text": "GraphQL API (recommended)",
                    "size": 4,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_v2Intro": {
                    "type": "staticText",
                    "text": "Same email and password as the Hydrawise app. Zones, schedules, plus sensors, weather and water use. Do not poll faster than every 2 minutes.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "enableV2": {
                    "type": "checkbox",
                    "label": "Enable v2 API (GraphQL)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "v2Username": {
                    "type": "text",
                    "label": "v2 username",
                    "newLine": true,
                    "hidden": "!enableV2",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 5,
                    "xl": 5
                },
                "v2Password": {
                    "type": "password",
                    "label": "v2 password",
                    "newLine": true,
                    "hidden": "!enableV2",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 5,
                    "xl": 5
                },
                "apiIntervalV2": {
                    "type": "number",
                    "label": "v2 interval",
                    "newLine": true,
                    "default": 300,
                    "min": 120,
                    "unit": "s",
                    "hidden": "!enableV2",
                    "help": "v2 interval help",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        }
    }
}
